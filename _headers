# Cloudflare Pages reads this file for response headers.
# Mirrors what netlify.toml provided.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Font filenames carry the upstream version, so the contents never change under
# a given name. Caching them hard means a repeat visit uses the font straight
# from cache with no request, which is what stops text reflowing on load.
/fonts/files/*
  Cache-Control: public, max-age=31536000, immutable
